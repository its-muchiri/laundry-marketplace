# Laundry Marketplace - Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
PILOT_TOWN=Kutus

# ============================================
# DATABASE (PostgreSQL + PostGIS)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=laundry_marketplace
DB_SYNCHRONIZE=true
DB_LOGGING=true
DB_SSL=false

# ============================================
# JWT
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# MONEY SETTINGS (All amounts in KES cents)
# ============================================
# Provider commission (15% for Bronze tier)
PROVIDER_COMMISSION_RATE=0.15

# Delivery fee settings
DELIVERY_BASE_FEE=10000          # KES 100.00 base fee per leg
DELIVERY_PER_KM_RATE=5000        # KES 50.00 per km
PEAK_SURCHARGE=5000              # KES 50.00 peak hour surcharge
PLATFORM_SHARE_MIN=0.10          # Platform keeps 10% of delivery fee
PLATFORM_SHARE_MAX=0.20          # Platform keeps up to 20% of delivery fee

# Service fee (flat fee per order)
SERVICE_FEE=2000                 # KES 20.00 per order
CHARGE_SERVICE_FEE=true          # Whether to charge service fee at launch

# Price variance threshold (15%)
PRICE_VARIANCE_THRESHOLD=0.15

# ============================================
# DISPATCH SETTINGS
# ============================================
DISPATCH_OFFER_TIMEOUT_MS=30000     # 30 seconds per rider offer
DISPATCH_MAX_MISSES_BEFORE_WIDEN=3  # Widen radius after 3 misses
DISPATCH_RADIUS_WIDEN_FACTOR=1.5    # Multiply radius by 1.5 each widen

# ============================================
# DISPUTE & COMPENSATION
# ============================================
DISPUTE_WINDOW_HOURS=24
COMPENSATION_CAP_PER_ITEM=500000      # KES 5,000.00 per item
COMPENSATION_CAP_PER_ORDER=2000000    # KES 20,000.00 per order

# ============================================
# GOOGLE MAPS API
# ============================================
# Browser key (restricted by website + APIs: Maps JS, Places, Geocoding)
GOOGLE_MAPS_API_KEY=your-browser-api-key

# Same browser key, exposed to Next.js (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-api-key

# Server key (restricted by IP + APIs: Routes, Geocoding)
GOOGLE_MAPS_SERVER_KEY=your-server-api-key

# ============================================
# M-PESA DARAJA (Safaricom)
# ============================================
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379                 # Till number or paybill
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/callback
MPESA_ENVIRONMENT=sandbox              # sandbox or production

# ============================================
# AFRICA'S TALKING (SMS)
# ============================================
AFRICAS_TALKING_USERNAME=your-username
AFRICAS_TALKING_API_KEY=your-api-key
AFRICAS_TALKING_SENDER_ID=LaundryKE

# ============================================
# FIREBASE (Push Notifications)
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ============================================
# CARD PROVIDERS (Phase 2)
# ============================================
# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Pesapal
PESAPAL_CONSUMER_KEY=your-consumer-key
PESAPAL_CONSUMER_SECRET=your-consumer-secret

# ============================================
# OTP SETTINGS
# ============================================
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_RATE_LIMIT_PER_HOUR=3